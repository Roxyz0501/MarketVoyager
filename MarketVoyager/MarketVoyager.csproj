<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>1.0.1.5</Version><Authors>Roxyz0501</Authors><PlatformTarget>x64</PlatformTarget>
    <RepoUrl>https://github.com/Roxyz0501/MarketVoyager</RepoUrl>
    <IconUrl>https://raw.githubusercontent.com/Roxyz0501/MarketVoyager/main/MarketVoyager/images/icon.png</IconUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Deterministic>true</Deterministic><DebugType>none</DebugType><DebugSymbols>false</DebugSymbols>
    <PathMap>$(MSBuildProjectDirectory)=/_/MarketVoyager</PathMap>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <DalamudLibPath>$(appdata)\XIVLauncher\addon\Hooks\dev\</DalamudLibPath>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup><None Include="images/icon.png" CopyToOutputDirectory="PreserveNewest"/></ItemGroup>
</Project>
